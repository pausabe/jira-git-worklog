# ---- Jira Cloud ----
# Base URL de vuestra instancia (sin barra final)
JIRA_BASE_URL=https://your-company.atlassian.net
# Email de tu cuenta Atlassian
JIRA_EMAIL=your-email@example.com
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# ---- GitHub ----
# Personal Access Token con acceso a los repos de la organizacion.
#  - Classic: scopes 'repo' + 'read:org'
#  - Fine-grained: Repository access = la org; permisos Contents:Read + Metadata:Read
GITHUB_TOKEN=
# Owner de los repos (organizacion o usuario)
GITHUB_ORG=your-org

# ---- Servidor ----
PORT=4000
# Ruta al fichero de reglas (editable desde la web). Por defecto ./config.yaml
CONFIG_PATH=./config.yaml
